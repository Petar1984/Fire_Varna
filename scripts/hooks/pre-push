#!/bin/sh
# Push policy for Fire_Varna — the tracked source of .git/hooks/pre-push.
# Install with:  cp scripts/hooks/pre-push .git/hooks/pre-push
#
# Three lines of defence, in this order:
#   1. a human at an interactive terminal (agents and scripts are blocked);
#   2. `python -m unittest discover -s tests` — the suite;
#   3. `python -m gates.run_gates` — one exit code for every gate, release
#      gate (проверка 6) and signature authorship (проверка 7) included.
#
# There is NO break-glass any more (план „ИЗЧИСТВАНЕ“ v2 §0.4, Q7). It existed
# for the red gate alone and it was still an environment variable away from
# publishing an unsigned delivery — „червено = блокирано“ has no second half.
# A push that must happen with a red gate happens after the gate is made green
# or after Petar removes this hook with his own hand, and both leave a trace.

set -u

# ---- 1. the human check (unchanged since the hook was introduced) ----
if [ ! -t 2 ]; then
  echo "" >&2
  echo "  ⛔ push blocked — non-interactive (agent/script) push detected." >&2
  echo "     A human must push from an interactive terminal." >&2
  echo "" >&2
  exit 1
fi

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "  ⛔ push blocked — not inside a git worktree." >&2
  exit 1
}
cd "$ROOT" || exit 1

# ---- 2. the suite ----
# PYTHONIOENCODING is set for THIS step only. The gate reconfigures its own
# console (gates/coverage.py `use_utf8_console`) and is therefore run bare — a
# hook that props the gate up hides the day it stops standing on its own
# (Амандамент №2, A.10). `unittest` is stdlib: we do not own its console
# handling, and a UnicodeEncodeError there would be a red that teaches the
# human to bypass the hook instead of a red that means something.
PYTHONIOENCODING=utf-8 python -m unittest discover -s tests
TESTS=$?
if [ "$TESTS" -ne 0 ]; then
  echo "" >&2
  echo "  ⛔ push blocked — tests red (python -m unittest discover -s tests → $TESTS)." >&2
  echo "     Червено = блокирано. Виж имената по-горе." >&2
  echo "" >&2
  exit 1
fi

# ---- 3. the gates ----
python -m gates.run_gates
GATES=$?
if [ "$GATES" -ne 0 ]; then
  echo "" >&2
  echo "  ⛔ push blocked — gates red (python -m gates.run_gates → $GATES)." >&2
  echo "     Виж таблицата по-горе, gates/out/coverage.md и опашката" >&2
  echo "     scratch/places_search/ЗА_ПОДПИС_<дата>.md." >&2
  echo "" >&2
  exit 1
fi

exit 0
